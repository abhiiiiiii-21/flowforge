generator client {
      provider = "prisma-client"
      output   = "../src/generated/prisma"
}

datasource db {
      provider = "postgresql"
}

//
// ─── ENUMS ─────────────────────────────────────────────
//

enum RunStatus {
      PENDING
      RUNNING
      COMPLETED
      FAILED
}

enum NodeStatus {
      PENDING
      RUNNING
      SUCCESS
      FAILED
}

enum RunScope {
      FULL
      PARTIAL
      SINGLE
}

//
// ─── MODELS ────────────────────────────────────────────
//

model User {
      id String @id // Clerk user ID

      workflows Workflow[]

      createdAt DateTime @default(now())
}

model Workflow {
      id String @id @default(cuid())

      userId String
      user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

      name String @default("Untitled Workflow")

      versions WorkflowVersion[]

      createdAt DateTime @default(now())
      updatedAt DateTime @updatedAt

      @@index([userId])
}

model WorkflowVersion {
      id String @id @default(cuid())

      workflowId String
      workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

      version Int
      graph   Json

      isPublished Boolean @default(false)

      createdAt DateTime @default(now())

      runs Run[]

      @@unique([workflowId, version])
      @@index([workflowId])
}

model Run {
      id String @id @default(cuid())

      userId String @default("anonymous")

      status RunStatus @default(PENDING)
      scope  RunScope  @default(FULL)

      graph Json

      workflowVersionId String
      workflowVersion   WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)

      triggerRunId String? @unique

      createdAt DateTime @default(now())
      updatedAt DateTime @updatedAt

      nodeExecutions NodeExecution[]

      @@index([workflowVersionId])
      @@index([userId])
}

model NodeExecution {
      id String @id @default(cuid())

      runId String
      run   Run    @relation(fields: [runId], references: [id], onDelete: Cascade)

      nodeId String
      status NodeStatus @default(PENDING)

      input  Json?
      output Json?
      error  String?

      startedAt  DateTime?
      finishedAt DateTime?

      @@unique([runId, nodeId])
      @@index([runId])
}