# ==============================================================================
# ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env or .env.local and fill in the values.
#
# QUICK START (Local Development):
# Only DATABASE_URL is strictly required to browse the dashboard and design workflows.
# If Clerk keys are omitted, the app automatically runs in local "anonymous" mode!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (Required)
# ------------------------------------------------------------------------------
# Neon serverless PostgreSQL connection string (or local PostgreSQL).
# Recommended: Create a free database at https://neon.tech
DATABASE_URL="postgresql://username:password@ep-xyz-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION — CLERK (Optional for local dev)
# ------------------------------------------------------------------------------
# If left empty, the application runs in local anonymous mode automatically.
# Get keys at: https://clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# 3. BACKGROUND TASK ORCHESTRATION — TRIGGER.DEV (Required for workflow execution)
# ------------------------------------------------------------------------------
# Trigger.dev manages DAG execution, automatic retries, and long-running AI tasks.
# Get credentials at: https://cloud.trigger.dev (or run local trigger dev server)
TRIGGER_SECRET_KEY=""
TRIGGER_PROJECT_ID=""

# ------------------------------------------------------------------------------
# 4. ARTIFICIAL INTELLIGENCE (Required for LLM Node execution)
# ------------------------------------------------------------------------------
# Google Gemini API Key for multimodal reasoning and text generation:
# Get free key at: https://aistudio.google.com
GOOGLE_GENERATIVE_AI_API_KEY=""

# Stability AI API Key for image generation tasks:
# Get key at: https://platform.stability.ai
STABILITY_API_KEY=""

# ------------------------------------------------------------------------------
# 5. MEDIA STORAGE & UPLOADS — TRANSLOADIT / CLOUDFLARE R2 (For file uploads)
# ------------------------------------------------------------------------------
# Transloadit handles direct media uploads (images and videos):
# Get keys at: https://transloadit.com
TRANSLOADIT_AUTH_KEY=""
TRANSLOADIT_SECRET=""

# Optional: Cloudflare R2 Public CDN URL (if using custom R2 storage for assets)
R2_PUBLIC_URL=""
